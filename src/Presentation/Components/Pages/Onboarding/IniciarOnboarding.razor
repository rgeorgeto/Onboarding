@page "/onboarding/iniciar"
@rendermode InteractiveServer
@using MediatR
@using Application.Modules.Commands.IniciarOnboarding
@using Application.Modules.Queries.ObterProgresso
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Iniciar Onboarding</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Iniciar Onboarding</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Erro))
                    {
                        <div class="alert alert-danger">@Erro</div>
                    }

                    @if (Sucesso)
                    {
                        <div class="alert alert-success">
                            Onboarding iniciado com sucesso!
                        </div>
                        <div class="d-grid">
                            <button class="btn btn-primary" @onclick="IrParaProgresso">
                                Ver Progresso
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">ID do Profissional</label>
                            <input type="text" class="form-control" @bind="ProfissionalIdTexto"
                                   placeholder="00000000-0000-0000-0000-000000000000" />
                            <small class="text-muted">Informe o GUID do profissional</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Data de Admissao</label>
                            <input type="date" class="form-control" @bind="DataAdmissao" />
                        </div>
                        <div class="d-grid">
                            <button class="btn btn-primary" @onclick="Iniciar" disabled="@Carregando">
                                @(Carregando ? "Iniciando..." : "Iniciar Onboarding")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string ProfissionalIdTexto = string.Empty;
    private DateTime DataAdmissao = DateTime.Today;
    private string? Erro;
    private bool Carregando;
    private bool Sucesso;

    private void IrParaProgresso()
    {
        Navigation.NavigateTo("/onboarding/progresso");
    }

    private async Task Iniciar()
    {
        Erro = null;
        Carregando = true;

        try
        {
            if (!Guid.TryParse(ProfissionalIdTexto, out var profissionalId))
            {
                Erro = "ID do profissional invalido. Informe um GUID valido.";
                return;
            }

            var command = new IniciarOnboardingCommand(profissionalId, DataAdmissao);
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                Sucesso = true;
            }
            else
            {
                Erro = result.Error;
            }
        }
        catch (Exception ex)
        {
            Erro = $"Erro ao iniciar onboarding: {ex.Message}";
        }
        finally
        {
            Carregando = false;
        }
    }
}
