@page "/"
@using Microsoft.AspNetCore.Components.Routing

<div class="container mt-4">
    <!-- Boas-vindas -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6">Bem-vinda, Ana Silva!</h1>
                    <p class="text-muted">Estamos felizes em tê-la conosco!</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary fs-6">Progresso geral: 45%</span>
                </div>
            </div>
            <div class="progress mt-2" style="height: 8px;">
                <div class="progress-bar" role="progressbar" style="width: 45%;" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </div>

    <!-- Cards de Trilhas -->
    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Cultura e Jeito SouzaOkawa</h5>
                    <p class="card-text">Conheça os valores, missão e a cultura que nos move.</p>
                    <span class="badge bg-warning text-dark">Em andamento</span>
                    <a href="/jornada" class="btn btn-sm btn-outline-primary mt-2 d-block">Continuar</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Pessoas e Áreas</h5>
                    <p class="card-text">Descubra as pessoas-chave e as áreas da empresa.</p>
                    <span class="badge bg-success">Concluído</span>
                    <a href="/jornada" class="btn btn-sm btn-outline-primary mt-2 d-block">Revisar</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Ferramentas do Dia a Dia</h5>
                    <p class="card-text">Aprenda a usar as ferramentas essenciais para o trabalho.</p>
                    <span class="badge bg-secondary">Não iniciado</span>
                    <a href="/jornada" class="btn btn-sm btn-outline-primary mt-2 d-block">Iniciar</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Primeiros Passos</h5>
                    <p class="card-text">Orientações iniciais para começar com o pé direito.</p>
                    <span class="badge bg-warning text-dark">Em andamento</span>
                    <a href="/jornada" class="btn btn-sm btn-outline-primary mt-2 d-block">Continuar</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sua próxima missão -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Sua próxima missão</h5>
            <p class="card-text">Complete o módulo "Apresentação Pessoal" na trilha de Pessoas e Áreas.</p>
            <a href="/jornada" class="btn btn-primary">Ir para a missão</a>
        </div>
    </div>

    <!-- Conquistas -->
    <div class="row mb-4">
        <div class="col">
            <h5>Conquistas</h5>
            <div class="d-flex gap-3">
                <div class="text-center">
                    <span class="badge bg-success fs-2">🏆</span>
                    <p class="mb-0 small">Primeira trilha</p>
                </div>
                <div class="text-center">
                    <span class="badge bg-secondary fs-2">🔒</span>
                    <p class="mb-0 small">5 dias seguidos</p>
                </div>
                <div class="text-center">
                    <span class="badge bg-secondary fs-2">🔒</span>
                    <p class="mb-0 small">Expert em ferramentas</p>
                </div>
            </div>
        </div>
    </div>
</div>