@page "/conclusao"
@using Microsoft.AspNetCore.Components.Routing

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-4">
                <h1 class="display-4 text-success">Parabéns!</h1>
                <p class="lead">Você concluiu o processo de onboarding com sucesso. Estamos felizes em tê-lo a bordo!</p>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Resumo da sua jornada</h5>
                    <p><strong>Progresso final:</strong> @Progresso%</p>
                    <p><strong>Módulos concluídos:</strong> @ModulosConcluidos de @TotalModulos</p>
                    <p>Você completou todas as etapas essenciais. Agora está pronto para começar com o pé direito!</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Suas conquistas</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <i class="bi bi-trophy-fill text-warning me-2"></i> Primeiro acesso ao sistema
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-trophy-fill text-warning me-2"></i> Conclusão do treinamento inicial
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-trophy-fill text-warning me-2"></i> Boas-vindas da equipe
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Próximos passos</h5>
                    <ol class="list-group list-group-numbered">
                        <li class="list-group-item">Revisar a documentação completa da empresa</li>
                        <li class="list-group-item">Agendar uma reunião com seu mentor</li>
                        <li class="list-group-item">Explorar os projetos em andamento</li>
                    </ol>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a href="/" class="btn btn-primary">Ir para Home</a>
                <a href="/progresso" class="btn btn-outline-secondary">Ver Progresso</a>
            </div>
        </div>
    </div>
</div>

@code {
    private int Progresso { get; set; } = 100;
    private int ModulosConcluidos { get; set; } = 5;
    private int TotalModulos { get; set; } = 5;
}