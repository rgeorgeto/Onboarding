@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using Application.Services
@implements IDisposable
@inject LayoutStateService LayoutState

<NavLink href="@Href" Match="@Match" class="@ItemCssClass">
    <span class="item-icon">
        <MudIcon Icon="@Icon" Size="Size.Small" Color="Color.Inherit" />
    </span>
    @if (LayoutState.IsSidebarOpen)
    {
        <span class="item-label">@Label</span>
    }
</NavLink>

@code {
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Href { get; set; } = string.Empty;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    protected override void OnInitialized() => LayoutState.OnChange += HandleStateChanged;
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);
    private string ItemCssClass => LayoutState.IsSidebarOpen ? "sidebar-item" : "sidebar-item collapsed-item";
    public void Dispose() => LayoutState.OnChange -= HandleStateChanged;
}
