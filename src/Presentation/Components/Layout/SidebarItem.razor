@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using Application.Services
@inject LayoutStateService LayoutState
@implements IDisposable

<NavLink class="@GetItemClass()" href="@Href" Match="@Match" title="@Label">
    <MudIcon Icon="@Icon" Class="item-icon" />
    @if (LayoutState.IsSidebarOpen)
    {
        <span class="item-label">@Label</span>
    }
</NavLink>

@code {
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Href { get; set; } = string.Empty;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    protected override void OnInitialized()
    {
        LayoutState.OnChange += OnLayoutChanged;
    }

    private async void OnLayoutChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string GetItemClass()
    {
        return LayoutState.IsSidebarOpen ? "sidebar-item" : "sidebar-item collapsed-item";
    }

    public void Dispose()
    {
        LayoutState.OnChange -= OnLayoutChanged;
    }
}