@inherits LayoutComponentBase
@using MudBlazor
@using Application.Services
@inject LayoutStateService LayoutState
@implements IDisposable

<div class="layout-shell">
    <div class="sidebar-wrapper @(LayoutState.IsSidebarOpen ? "expanded" : "collapsed")">
        <Sidebar />
    </div>
    <div class="main-wrapper">
        <div class="topbar-wrapper">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu" OnClick="ToggleSidebar" Class="toggle-btn" />
            <span>Onboarding do Colaborador</span>
        </div>
        <div class="body-wrapper">
            <div class="body-content">
                @Body
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        LayoutState.OnChange += StateHasChanged;
    }

    private void ToggleSidebar()
    {
        LayoutState.IsSidebarOpen = !LayoutState.IsSidebarOpen;
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
    }
}